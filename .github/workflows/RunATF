name: Run ServiceNow ATF
on:
  push:
    branches:
      - main
jobs:
  run-atf-tests:
    runs-on: ubuntu-latest
    environment: Devenv
    steps:
      - name: Trigger ServiceNow ATF Test Suite
        env:
          SN_INSTANCE: ${{ secrets.SN_INSTANCE }}
          SN_USER: ${{ secrets.SN_USER }}
          SN_PASSWORD: ${{ secrets.SN_PASSWORD }}
          TEST_SUITE_ID: ${{ secrets.SN_TEST_SUITE_SYS_ID }}
        run: |
          response=$(curl -sS -w "\n%{http_code}" -X POST \
            "https://${SN_INSTANCE}/api/sn_cicd/testsuite/run?test_suite_sys_id=${TEST_SUITE_ID}" \
            -u "${SN_USER}:${SN_PASSWORD}" \
            -H "Content-Type: application/json")
          code=$(echo "$response" | tail -n 1)
          echo "HTTP $code"
          echo "$response" | head -n -1
          [ "$code" -ge 400 ] && { echo "ATF trigger failed"; exit 1; } || true
